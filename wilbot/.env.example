DISCORD_TOKEN=your_discord_bot_token
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key

# Set to false to disable DeepSeek V4 ultra thinking/reasoning mode
ULTRA_THINKING=true

# Override the Zen model (default: deepseek-v4-flash-free)
# MODEL=deepseek-v4-pro

# Optional: where skills and conversation data are stored
# SKILLS_DIR=./skills
# DATA_DIR=./data
# DATA_SKILLS_DIR=./data/skills
